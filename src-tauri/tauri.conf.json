{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duckbench",
  "version": "1.1.0",
  "identifier": "com.duckbench.desktop",
  "build": {
    "frontendDist": "../app/src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Duckbench",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Duckbench",
    "shortDescription": "Point-and-click data cleaning on a native DuckDB engine",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["duckbench"],
        "name": "Duckbench project",
        "description": "Duckbench project",
        "role": "Editor",
        "mimeType": "application/x-duckbench"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Arabic"],
        "displayLanguageSelector": false
      }
    }
  }
}
